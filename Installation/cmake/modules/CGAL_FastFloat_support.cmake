if (FastFloat_VERSION VERSION_GREATER_EQUAL "6.0.0")
  if(FastFloat_FOUND AND NOT TARGET CGAL::FastFloat_support)
    add_library(CGAL::FastFloat_support INTERFACE IMPORTED)
    set_target_properties(CGAL::FastFloat_support PROPERTIES INTERFACE_COMPILE_DEFINITIONS "CGAL_USE_FASTFLOAT")
    target_link_libraries(CGAL::FastFloat_support INTERFACE FastFloat::fast_float)
  endif()
else()
  message(STATUS "FastFloat found but version at least 6.0.0 is required")
endif()

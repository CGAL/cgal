@article{r-crsaa-92
, author =      "G{\"u}nter Rote"
, title =       "The convergence rate of the {Sandwich} algorithm for approximating convex functions"
, journal =     "Computing"
, volume =      48
, year =        1992
, pages =       "337--361"
, succeeds =    "r-crsaa-90"
, cites =       "bhr-saucf-91"
, update =      "98.03 mitchell, 97.03 rote"
, abstract =    "The Sandwich algorithm approximates a convex function of
                one variable over an interval by evaluating the function and its
                derivative at a sequence of points. The connection of the
                obtained points is a piecewise linear upper approximation, and
                the tangents yield a piecewise linear lower approximation.
                Similarly, a PLANAR CONVEX FIGURE can be approximated by
                convex polygons.
                Different versions of the Sandwich algorithm use different rules
                for selecting the next evaluation point. We consider four natural
                rules (interval bisection, slope bisection, maximum error rule,
                and chord rule) and show that the global approximation error
                with $n$ evaluation points decreases by the order of $O(1/n^2)$,
                which is optimal."
}


@article{a-gvdps-89
, author =      "Boris Aronov"
, title =       "On the geodesic {Voronoi} diagram of point sites in a simple polygon"
, journal =     "Algorithmica"
, volume =      4
, year =        1989
, pages =       "109--140"
, keywords =    "geodesic distance, Voronoi diagram, simple polygon, shortest path"
, succeeds =    "a-gvdps-87"
, update =      "96.05 efrat, 95.01 aronov"
, abstract =    "Given a simple polygon with $n$ sides in the plane
and a set of $k$ point ``sites'' in its interior or on the boundary,
compute the Voronoi diagram of the set of sites using the internal
``geodesic'' distance inside the polygon as the metric. We describe an
$O((n+k)\log(n+k)\log n )$-time algorithm for solving this
problem and sketch a faster $O((n+k)\log(n+k))$ algorithm for the case when
the set of sites includes all reflex vertices of the polygon in question."
}


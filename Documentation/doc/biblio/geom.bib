, author =      "Boris Aronov and Bernard Chazelle and Herbert Edelsbrunner and Leonidas J. Guibas and Micha Sharir and Rephael Wenger"
, title =       "Points and triangles in the plane and halving planes in space"
, journal =     "Discrete Comput. Geom."
, volume =      6
, year =        1991
, pages =       "435--442"
, keywords =    "combinatorial geometry, halving sets, $k$-sets"
, succeeds =    "acegsw-ptphp-90"
, update =      "95.01 aronov"
, abstract =    "We prove that for any set $S$ of $n$ points in the plane and
  $n^{3-\alpha}$ triangles spanned by the points in $S$ there
  exists a point (not necessarily in $S$) contained in at least
  $n^{3-3\alpha} \over c \log^5n$ of the triangles.
  This implies that any set of $n$ points in three-dimensional space
  defines at most $\sqrt[3]{c \over 2} n^{8/3}\log^{5/3}n$ halving planes."
}


@article{s-iabdt-92
, author =      "Kokichi Sugihara"
, title =       "An Intersection Algorithm Based On {Delaunay} Triangulation"
, journal =     "IEEE Comput. Graph. Appl."
, volume =      12
, number =      2
, month =       mar
, year =        1992
, pages =       "59--67"
, keywords =    "Delaunay triangulation, computational geometry"
, abstract =    "A robust method for finding points of intersection of
                 line segments in a 2- D plane is presented. The plane
                 is subdivided by Delaunay triangulation to localize
                 areas where points of intersection exist and to
                 guarantee the topological consistency of the resulting
                 arrangement. The subdivision is refined by inserting
                 midpoints recursively until the areas containing points
                 of intersection are sufficiently localized. The method
                 is robust in the sense that it does not miss points of
                 intersection that are easily detectable when costly
                 line-pair checking is performed. The algorithm is
                 adaptive in the sense that most of the computational
                 cost is incurred for the areas where finding points of
                 intersection is difficult. 6 Refs."
}

